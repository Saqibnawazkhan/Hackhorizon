# ==========================================================================
# AgentFlow web console
# Copy to .env.local. Nothing here is secret — see the note on the anon key.
# ==========================================================================

# Where the FastAPI backend is listening. `python run_local.py` serves :8000.
# Use 127.0.0.1 rather than localhost: on Windows, localhost can resolve to
# ::1 first while uvicorn binds 127.0.0.1, which fails with no useful error.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# The same Supabase project the Flutter app signs into, so a session created
# in either client is the same session to the backend.
NEXT_PUBLIC_SUPABASE_URL=https://jbdrqulyenfwzouoktxu.supabase.co

# The PUBLISHABLE (anon) key. It is designed to be shipped in a client and
# grants nothing beyond what row-level security allows. The SECRET key
# (SUPABASE_SERVICE_ROLE_KEY) belongs only in backend/.env and must never
# appear in this file — anything prefixed NEXT_PUBLIC_ is compiled into the
# browser bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_VX9zf91woOUl6Wk_hTbfPA_g495DDwi
