# ==========================================================================
# AgentFlow backend configuration
# Copy to .env and fill in the secrets. Never commit .env.
# ==========================================================================

# -- App -------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*

# -- Money -----------------------------------------------------------------
DEFAULT_CURRENCY=PKR
SUPPORTED_CURRENCIES=PKR,USD

# -- Supabase --------------------------------------------------------------
# Project URL and publishable (anon) key: Dashboard > Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# SECRET key (formerly service_role). Backend-only -- bypasses RLS so the
# agent can write execution rows. NEVER ship this to the Flutter app.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Used to verify Supabase Auth JWTs in FastAPI.
# Dashboard > Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=

# Storage bucket for generated PO PDFs (created by scripts/bootstrap_storage.py)
SUPABASE_STORAGE_BUCKET=purchase-orders
SIGNED_URL_EXPIRY_SECONDS=3600

# -- Postgres --------------------------------------------------------------
# Dashboard > Connect > ORM / Direct connection.
# Use the SESSION POOLER (port 5432) URI -- IPv4-safe and works from Railway.
# Format: postgresql+psycopg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# A liveness `SELECT 1` on every pool checkout. That is a full round trip, so
# against an out-of-region Supabase project it adds ~200ms to EVERY request --
# measured: 1.5ms for a route that touches no database, 700-1200ms for one
# that does. pool_recycle already retires connections inside Supabase's idle
# timeout, so this defaults off. Turn it on only for a pooler that drops
# connections earlier than expected.
DATABASE_POOL_PRE_PING=false

# How long a verified token's resolved identity (role, org, vendor profile) is
# reused before public.users is read again. Without it every authenticated
# request spends an extra round trip re-learning something that changes maybe
# once a month. The JWT signature is ALWAYS verified regardless -- only the
# database lookup is cached -- so an expired or forged token cannot get
# through. Set 0 to disable.
AUTH_IDENTITY_CACHE_SECONDS=30

# LangGraph PostgresSaver. Leave blank to reuse DATABASE_URL.
CHECKPOINTER_DATABASE_URL=

# -- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
AGENT_MAX_TOKENS_PLANNER=2048
AGENT_TEMPERATURE_PLANNER=0.0
AGENT_PLANNER_MAX_PARSE_ATTEMPTS=3
AGENT_MAX_SELF_CORRECTION_ATTEMPTS=2
AGENT_TOOL_MAX_ATTEMPTS=3
AGENT_TOOL_BACKOFF_BASE_SECONDS=0.5
AGENT_TOOL_BACKOFF_MULTIPLIER=2.0
AGENT_TOOL_BACKOFF_MAX_SECONDS=8.0
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_LLM_TIMEOUT_SECONDS=60

# -- Scoring (admin-configurable at runtime; these are the fallbacks) -------
SCORING_WEIGHT_PRICE=0.50
SCORING_WEIGHT_DELIVERY=0.30
SCORING_WEIGHT_WARRANTY=0.20
SCORING_WEIGHT_RELIABILITY=0.00
SCORING_MISSING_FIELD_NEUTRAL_SCORE=0.5
SCORING_NEW_VENDOR_NEUTRAL_RELIABILITY=0.5
SCORING_SPLIT_ORDER_OVERHEAD_PER_EXTRA_PO=25000
SCORING_SPLIT_LEAD_TIME_PENALTY_PER_DAY=0.5

# -- Vendor performance monitoring -----------------------------------------
VENDOR_FLAG_AFTER_LATE_DELIVERIES=2
VENDOR_FLAG_BELOW_ON_TIME_RATE=0.80
VENDOR_FLAG_AFTER_CANCELLATIONS=2
VENDOR_FLAG_BELOW_QUANTITY_ACCURACY=0.95
VENDOR_MIN_ORDERS_FOR_RELIABILITY=3
VENDOR_RELIABILITY_SCAN_INTERVAL_SECONDS=3600
VENDOR_LOW_STOCK_THRESHOLD=20

# -- Notifications ---------------------------------------------------------
NOTIFICATIONS_ENABLED=true
SLACK_WEBHOOK_URL=
# Paste the Firebase service-account JSON as a single line, or a path to it.
FIREBASE_CREDENTIALS_JSON=

# -- Imports ---------------------------------------------------------------
IMPORT_MAX_ROWS=5000
IMPORT_MAX_FILE_BYTES=5242880

# -- WebSocket -------------------------------------------------------------
WS_HEARTBEAT_SECONDS=25
WS_REPLAY_BUFFER_SIZE=500
